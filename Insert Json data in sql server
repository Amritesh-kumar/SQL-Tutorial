--CREATE TABLE STUDENTDETAILS(
--	ID INT IDENTITY PRIMARY KEY,
--	EDUCATION NVARCHAR(MAX)
--);

SELECT * FROM STUDENTDETAILS;


SELECT 
    JSON_VALUE(EDUCATION, '$.education."10th".schoolName') AS TenthSchool,
    JSON_VALUE(education, '$.education."10th".marks') AS TenthMarks,
	JSON_VALUE(education, '$.education.diploma.collegeName') AS diplomaSchool,
    JSON_VALUE(education, '$.education."12th".marks') AS Marks,
	JSON_VALUE(education, '$.education.btech.collegeName') AS TenthSchool,
    JSON_VALUE(education, '$.education.btech.marks') AS TenthMarks

FROM STUDENTDETAILS;
